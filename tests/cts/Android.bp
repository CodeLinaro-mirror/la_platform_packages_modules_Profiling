package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_system_performance",
}

android_test {
    name: "CtsProfilingModuleTests",
    defaults: ["cts_defaults"],
    data: [
        ":CtsProfilingTestApp",
    ],
    static_libs: [
        "androidx.test.rules",
        "androidx.test.ext.truth",
        "compatibility-device-util-axt",
        "ctstestrunner-axt",
        "cts-wm-util",
        "modules-utils-build",
        "service-profiling",
        "profiling_flags_not_exported_lib",
        "framework-profiling.impl",
        "testng",
    ],
    libs: [
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "android.test.mock.stubs.system",
        "junit",
    ],
    // include both the 32 and 64 bit versions
    compile_multilib: "both",
    srcs: [
        "src/android/profiling/cts/*.java",
    ],
    jni_libs: [
        "libcts_profiling_module_test_native",
    ],
    jarjar_rules: "jarjar-rules.txt",
    test_mainline_modules: ["com.google.android.profiling.apex"],
    test_suites: [
        "cts",
        "general-tests",
        "mts-profiling",
        "mcts-profiling",
    ],
    min_sdk_version: "35",
    sdk_version: "module_current",
}

android_test_helper_app {
    name: "CtsProfilingTestApp",
    defaults: ["cts_defaults"],
    sdk_version: "system_current",
    srcs: [
        "src/android/profiling/cts/profilingapp/**/*.java",
        "src/android/profiling/cts/ProfilingTestUtils.java",
    ],
    min_sdk_version: "35",
    target_sdk_version: "35",
    static_libs: [
        "compatibility-device-util-axt", // For SystemUtil in ProfilingTestUtils
    ],
    test_suites: [
        "cts",
        "general-tests",
        "mts-profiling",
        "mcts-profiling",
    ],
    manifest: "src/android/profiling/cts/profilingapp/AndroidManifestProfilingApp.xml",
}
