filegroup {
    name: "util-profiling-sources",
    srcs: [
        "src/**/*.java",
    ],
}

java_library {
    name: "util-profiling",
    srcs: [":util-profiling-sources"],
    sdk_version: "system_server_current",
    libs: [
        "framework-annotations-lib",
        "jsr305",
    ],
    static_libs: [
        "util-profiling-proto",
    ],
    lint: {
        strict_updatability_linting: true,
    },
    apex_available: [
        "com.android.profiling",
    ],
    min_sdk_version: "35",
    installable: true,
}

java_library {
    name: "util-profiling-proto",
    proto: {
        type: "lite",
        canonical_path_from_root: false,
        include_dirs: [
            "external/protobuf/src",
            "external/protobuf/java",
        ],
    },
    srcs: [
        "proto/**/*.proto",
    ],
    visibility: [
        "//packages/modules/Profiling/tests:__subpackages__",
    ],
    installable: false,
    min_sdk_version: "35",
    sdk_version: "system_server_current",
    apex_available: [
        "com.android.profiling",
    ],
}
