aconfig_declarations {
    name: "android.os.profiling.flags-aconfig",
    package: "android.os.profiling",
    container: "com.android.profiling",
    exportable: true,
    srcs: ["flags.aconfig"],
}

java_aconfig_library {
    name: "profiling_flags_lib",
    aconfig_declarations: "android.os.profiling.flags-aconfig",
    apex_available: [
        "com.android.profiling",
        "//apex_available:platform",
    ],
    mode: "exported",
    min_sdk_version: "35",
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    visibility: [
        "//frameworks/base/services/core",
    ],
}

java_aconfig_library {
    name: "profiling_flags_not_exported_lib",
    aconfig_declarations: "android.os.profiling.flags-aconfig",
    apex_available: [
        "com.android.profiling",
        "//apex_available:platform",
    ],
    min_sdk_version: "35",
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    visibility: [
        "//packages/modules/Profiling:__subpackages__",
    ],
}
