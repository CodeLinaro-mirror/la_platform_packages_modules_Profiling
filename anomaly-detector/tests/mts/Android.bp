package {
    default_applicable_licenses: ["Android-Apache-2.0"],
    default_team: "trendy_team_system_performance",
}

android_test {
    name: "MtsAnomalyDetectorTests",
    defaults: ["modules-utils-extended-mockito-rule-defaults"],
    static_libs: [
        "androidx.test.rules",
        "androidx.test.ext.truth",
        "compatibility-device-util-axt",
        "ctstestrunner-axt",
        "cts-wm-util",
        "framework-configinfrastructure.stubs.module_lib",
        "service-anomaly-detector.impl",
        "StatsdTestUtils",
        "statsdprotolite",
        "anomaly-detector-aconfig-flags-lib",
        "framework-anomaly-detector.impl",
        "framework-profiling.impl",
        "testng",
        "services.core",
        "anomaly-detector-rules-proto-lite",
        "mockito-target-extended-minus-junit4",
    ],
    libs: [
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "android.test.mock.stubs.system",
        "junit",
        "framework-statsd.stubs.module_lib",
    ],
    compile_multilib: "both",
    srcs: [
        "//packages/modules/Profiling/anomaly-detector/service:anomaly-statslog-java-gen-src",
        "src/**/*.java",
    ],
    jarjar_rules: "jarjar-rules.txt",
    test_mainline_modules: ["com.google.android.profiling.apex"],
    test_suites: [
        "mts",
        "general-tests",
        "mts-profiling",
    ],
    test_config: "AndroidTest.xml",
    min_sdk_version: "36",
    sdk_version: "module_current",
}
