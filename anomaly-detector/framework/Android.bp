package {
    default_visibility: [":__pkg__"],
    default_applicable_licenses: ["Android-Apache-2.0"],
}

filegroup {
    name: "framework-anomaly-detector-sources",
    defaults: ["framework-sources-module-defaults"],
    srcs: [
        "java/**/*.java",
        ":framework-anomaly-detector-aidl-sources",
    ],
    visibility: ["//packages/modules/Profiling/anomaly-detector/framework:__subpackages__"],
}

java_sdk_library {
    name: "framework-anomaly-detector",
    defaults: ["framework-module-defaults"],
    installable: true,

    jarjar_rules: "jarjar-rules.txt",

    srcs: [
        ":framework-anomaly-detector-sources",
    ],

    aconfig_declarations: [
        "android.os.profiling.anomaly.flags-aconfig",
    ],

    static_libs: [
        "anomaly-detector-aconfig-flags-lib",
        "modules-utils-build",
    ],

    permitted_packages: [
        "android.app",
        "android.os.profiling.anomaly",
        "android.util",
        "com.android.internal.profiling.anomaly",
    ],

    api_packages: [
        "android.app",
        "android.os.profiling.anomaly",
        "android.util",
    ],

    hostdex: true, // for hiddenapi check

    impl_library_visibility: [
        "//packages/modules/Profiling/anomaly-detector/service:__subpackages__",
        "//packages/modules/Profiling/anomaly-detector/tests:__subpackages__",
    ],

    apex_available: [
        "com.android.profiling",
    ],
    min_sdk_version: "36",
}
