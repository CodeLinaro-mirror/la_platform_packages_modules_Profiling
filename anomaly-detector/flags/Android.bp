package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

aconfig_declarations {
    name: "android.os.profiling.anomaly.flags-aconfig",
    package: "android.os.profiling.anomaly.flags",
    container: "com.android.profiling",
    exportable: true,
    srcs: ["flags.aconfig"],
}

java_aconfig_library {
    name: "anomaly-detector-aconfig-flags-lib",
    aconfig_declarations: "android.os.profiling.anomaly.flags-aconfig",
    min_sdk_version: "36",
    apex_available: [
        "com.android.profiling",
    ],
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    visibility: [
        "//packages/modules/Profiling:__subpackages__",
    ],
}

java_aconfig_library {
    name: "anomaly-detector-exported-aconfig-flags-lib",
    aconfig_declarations: "android.os.profiling.anomaly.flags-aconfig",
    min_sdk_version: "36",
    mode: "exported",
    apex_available: [
        "com.android.profiling",
    ],
    defaults: ["framework-minus-apex-aconfig-java-defaults"],
    visibility: [
        "//packages/modules/Profiling:__subpackages__",
        "//packages/modules/Permission:__subpackages__",
        "//frameworks/base:__subpackages__",
    ],
}
